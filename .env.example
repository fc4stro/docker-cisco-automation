# Copie para .env e preencha. O arquivo .env NÃO deve ser versionado.
# Credenciais dos dispositivos de rede (usadas por group_vars/all.yml).
ANSIBLE_NET_USERNAME=admin
ANSIBLE_NET_PASSWORD=changeme
# Senha de enable/privilege (se aplicável):
# ANSIBLE_NET_AUTH_PASS=changeme

# Sobrescreve variáveis do Ansible, se quiser (já definidas na imagem):
# ANSIBLE_HOST_KEY_CHECKING=False
# ANSIBLE_NETWORK_CLI_SSH_TYPE=paramiko
